# Database-wachtwoord voor compose.yaml; nooit in git.
.env

# Terraform: state en tfvars kunnen sleutels en wachtwoorden bevatten.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/crash.log

# Bytecode van Python, die ontstaat bij het draaien; hoort niet in git.
__pycache__/
