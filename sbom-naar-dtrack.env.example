# Kopieer naar /etc/sbom-naar-dtrack.env, eigenaar root, rechten 0600; nooit in git.
# Fine-grained token van GitHub: alleen deze repository, alleen "Actions: Read-only", met een vervaldatum.
GITHUB_TOKEN=
# API-key van een team in Dependency-Track met alleen BOM_UPLOAD en PROJECT_CREATION_UPLOAD.
DT_API_KEY=
# Optioneel; dit zijn de standaardwaarden.
# DT_URL=http://127.0.0.1:8080
# REPO=Youssefontys/secure-app
# WORKFLOW=CI-image.yml
# PROJECT=secure-app
# Alleen voor dt-meting.py: een key van een team met alleen VIEW_PORTFOLIO en VIEW_VULNERABILITY.
# dt-bootstrap.py vult hem in; zonder deze key meet het script niets, de levering werkt wel.
DT_READ_KEY=
